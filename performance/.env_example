
BASE_URL=http://host.docker.internal:8080
# Single-batch / Distributed-batch
BATCH_MODE=single

VOUCHER_CODE=PERF-GENERIC-001

VOUCHER_CODES=PERF-MULTI-001,PERF-MULTI-002,PERF-MULTI-003,PERF-MULTI-004,PERF-MULTI-005,PERF-MULTI-006,PERF-MULTI-007,PERF-MULTI-008,PERF-MULTI-009,PERF-MULTI-010,PERF-MULTI-011,PERF-MULTI-012,PERF-MULTI-013,PERF-MULTI-014,PERF-MULTI-015,PERF-MULTI-016,PERF-MULTI-017,PERF-MULTI-018,PERF-MULTI-019,PERF-MULTI-020

